# Скопируйте этот файл в .env (он в .gitignore и НЕ попадёт в репозиторий).
# Все переменные опциональны — без них сайт работает, недоступен только AI-разбор.

# PORT=5000
# FLASK_DEBUG=0
# RATE_LIMIT_OFF=1   # отключить встроенный лимит запросов (для локалки)

# Макро-фон (вкладка «Обзор» → карточка «🌍 Макро-фон»). БЕСПЛАТНЫЙ ключ FRED:
# fred.stlouisfed.org/docs/api/api_key.html  (один ключ на весь инстанс)
# FRED_API_KEY=

# ============================================================================
# AI-разбор новостей. Код OpenAI-СОВМЕСТИМЫЙ — подходит ЛЮБОЙ провайдер с
# /chat/completions. Никогда не коммитьте реальный ключ в открытый репозиторий!
# Достаточно задать 3 переменные ниже. Выберите ОДИН вариант:
# ============================================================================

# --- Вариант 1 (РЕКОМЕНДУЕТСЯ ⭐): OpenRouter — openrouter.ai ---
# Бесплатные модели (суффикс :free), доступен из большинства регионов.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Вариант 2: Groq (бесплатно, очень быстро) — console.groq.com ---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- Вариант 3: Google Gemini (бесплатно, но низкие лимиты) — aistudio.google.com ---
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=...
# OPENAI_MODEL=gemini-2.0-flash

# --- Вариант 4: Ollama (полностью бесплатно, локально/на своём сервере) — ollama.com ---
# Установите Ollama и выполните: ollama pull llama3.1
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1

# --- Вариант 5: платный OpenAI (если нужно именно он) ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
