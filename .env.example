# Скопируйте в .env при необходимости (опционально)
# PORT=5000
# FLASK_DEBUG=0

# AI-разбор новостей (вкладка «Новости» → кнопка «AI-разбор»).
# Без ключа вкладка работает, но AI-разбор покажет сообщение о настройке.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Для OpenAI-совместимых сервисов укажите свой эндпоинт:
# OPENAI_BASE_URL=https://api.openai.com/v1
